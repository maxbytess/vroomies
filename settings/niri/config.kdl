input {
    keyboard {
        xkb {
            layout "tr"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-profile "flat"
    }

    mouse {
        accel-profile "flat"
    }

    focus-follows-mouse
}

output "eDP-1" {
    mode "1920x1080@144"
    scale 1.0
    transform "normal"
    position x=0 y=0
}

// ── Startup ───────────────────────────────────────────────────────────────────
spawn-at-startup "dbus-update-activation-environment" "--systemd" "--all"
spawn-at-startup "systemctl" "--user" "start" "xdg-desktop-portal"
spawn-at-startup "/nix/store/409xg4jpxgs56m0m62791dqcwkhp8dya-system-path/libexec/polkit-kde-authentication-agent-1"
// spawn-at-startup "polkit-kde-authentication-agent-1"
spawn-at-startup "nm-applet" "--indicator"
spawn-at-startup "blueman-applet"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "cursor-theme" "Bibata-Modern-Ice"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "cursor-size" "24"
spawn-at-startup "gsettings" "set" "org.gnome.desktop.interface" "gtk-decoration-layout" ":"
spawn-at-startup "awww-daemon"
spawn-sh-at-startup "sleep 1 && awww img ~/.config/niri/yuna --transition-type grow --transition-duration 1.5"
spawn-at-startup "qs" "-c" "nn"
spawn-at-startup "easyeffects &"

environment {
    MOZ_ENABLE_WAYLAND "1"
    GBM_BACKEND "nvidia-drm"
    __GLX_VENDOR_LIBRARY_NAME "nvidia"
    LIBVA_DRIVER_NAME "nvidia"
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ── Layout ────────────────────────────────────────────────────────────────────
layout {
    gaps 16

    background-color "#000000"
    center-focused-column "never"
    always-center-single-column

    default-column-width { proportion 0.5; }

    focus-ring {
        on
        width 2
        active-color "#ffffff"
        inactive-color "#333333"
    }

    border {
        off
        width 0
    }

    shadow {
        on
        softness 40
        spread 6
        offset x=0 y=6
        color "#00000060"
    }
}

// ── Animations ────────────────────────────────────────────────────────────────

animations {
    slowdown 1.0

    window-open {
        duration-ms 180
        curve "cubic-bezier" 0.05 0.7 0.1 1.0
    }

    window-close {
        duration-ms 130
        curve "cubic-bezier" 0.4 0.0 1.0 1.0
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.001
    }

    workspace-switch {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.001
    }
    
    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=450 epsilon=0.001
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=400 epsilon=0.001
    }
}


// ── Window Rules ──────────────────────────────────────────────────────────────
window-rule {
    match is-floating=true
    open-maximized false
}

window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-maximized false
}

window-rule {
    match app-id=r#"^org\.pulseaudio\.pavucontrol$"#
    open-floating true
}

window-rule {
    match app-id=r#"^blueman-manager$"#
    open-floating true
}

window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"# title=r#"^flutter picker$"#
    open-floating true
}

window-rule {
    match app-id=r#"^(firefox|kitty|code|obs|org\.telegram\.desktop|org\.kde\.dolphin)$"#
    open-maximized false
}

window-rule {
    geometry-corner-radius 8 8 8 8  
    clip-to-geometry true
}

// ── Binds ─────────────────────────────────────────────────────────────────────
binds {
    // Apps
    Mod+Return         { spawn "kitty"; }
    Mod+B              { spawn "flatpak run com.brave.Browser --enable-features=UseOzonePlatform --ozone-platform=wayland"; }
    Mod+E              { spawn "dolphin"; }
    Mod+D              { spawn-sh "rofi -show drun"; }
    Mod+Shift+W        { spawn "~/.config/niri/sc/wall"; }

    // Window management
    Mod+Shift+Q { close-window; }
    Mod+L       { spawn "hyprlock"; }
    Mod+Shift+A { spawn "code"; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { toggle-window-floating; }
    Mod+Tab     { toggle-overview; }

    // Screenshots
    Print      { screenshot; }
    Mod+Print  { spawn-sh "grim -g \"$(slurp)\" - | swappy -f -"; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Focus
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // Move
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up   { focus-workspace-up; }

    Mod+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp    cooldown-ms=150 { focus-workspace-up; }
    Mod+WheelScrollRight { focus-column-right; }
    Mod+WheelScrollLeft  { focus-column-left; }

    // Resize
    Mod+R              { switch-preset-column-width; }
    Mod+Shift+R        { switch-preset-window-height; }
    Mod+Ctrl+R         { reset-window-height; }
    Mod+C              { center-column; }
    Mod+Minus          { set-column-width "-10%"; }
    Mod+Equal          { set-column-width "+10%"; }
    Mod+Shift+Minus    { set-window-height "-10%"; }
    Mod+Shift+Equal    { set-window-height "+10%"; }

    // Media & hardware
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp    allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // System
    Mod+Shift+E { quit; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
}
