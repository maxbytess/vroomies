import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Io
import Quickshell.Wayland

PanelWindow {
    id: settingsWindow
    visible: settingsState.show
    exclusionMode: ExclusionMode.Ignore
    anchors { top: true; bottom: true; left: true; right: true }
    color: "transparent"
    focusable: true
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.keyboardFocus: settingsState.show ? WlrKeyboardFocus.Exclusive : WlrKeyboardFocus.None

    property string activeTab: "layout"

    onVisibleChanged: {
        if (!visible) settingsState.show = false
        else openAnim.restart()
    }

    ParallelAnimation {
        id: openAnim
        NumberAnimation { target: card; property: "scale"; from: 0.9; to: 1; duration: 260; easing.type: Easing.OutCubic }
        NumberAnimation { target: card; property: "opacity"; from: 0; to: 1; duration: 200 }
    }

    readonly property var effectiveFavs: (root.dockFavorites && root.dockFavorites.length > 0)
        ? root.dockFavorites : ["kitty", "firefox", "thunar"]
    function addFav(id) {
        id = (id || "").trim()
        if (id === "" || effectiveFavs.indexOf(id) >= 0) return
        var l = effectiveFavs.slice()
        l.push(id)
        root.dockFavorites = l
        root.saveSettings()
    }
    function removeFav(id) {
        var l = effectiveFavs.filter(function (x) { return x !== id })
        root.dockFavorites = l
        root.saveSettings()
    }

    readonly property var shortcuts: [
        { keys: "SUPER + Return",       action: "Open terminal (kitty)" },
        { keys: "SUPER + W",            action: "Open browser (firefox)" },
        { keys: "SUPER + SHIFT + Return", action: "Open file manager" },
        { keys: "SUPER + D",            action: "Open launcher" },
        { keys: "SUPER + Tab",          action: "Toggle overview" },
        { keys: "SUPER + SHIFT + A",    action: "Pick wallpaper" },
        { keys: "SUPER + F",            action: "Toggle floating window" },
        { keys: "SUPER + S",            action: "Toggle special workspace" },
        { keys: "SUPER + SHIFT + Q",    action: "Close window" },
        { keys: "SUPER + SHIFT + E",    action: "Log out" },
        { keys: "SUPER + L",            action: "Lock screen" },
        { keys: "SUPER + 1..0",         action: "Switch to workspace" },
        { keys: "SUPER + SHIFT + 1..0", action: "Move window to workspace" },
        { keys: "SUPER + Print",        action: "Take screenshot" }
    ]

    MouseArea {
        anchors.fill: parent
        onClicked: settingsState.show = false
    }

    Rectangle {
        id: card
        anchors.centerIn: parent
        width: 780; height: 540
        color: zyuTheme.widget_bg
        radius: zyuTheme.rounding
        border.width: 1
        border.color: Qt.rgba(1,1,1,0.06)
        clip: true

        MouseArea { anchors.fill: parent; onClicked: {} }

        Keys.onEscapePressed: settingsState.show = false
        focus: settingsState.show

    RowLayout {
        anchors.fill: parent
        spacing: 0

        Rectangle {
            Layout.fillHeight: true
            Layout.preferredWidth: 170
            color: Qt.darker(zyuTheme.widget_bg, 1.15)
            Behavior on color { ColorAnimation { duration: 300 } }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 12
                spacing: 4

                RowLayout {
                    Layout.fillWidth: true
                    Layout.bottomMargin: 10
                    Text {
                        text: "󰢻  Settings"
                        color: zyuTheme.bar_fg
                        font.family: "JetBrainsMono Nerd Font"
                        font.pixelSize: 15; font.bold: true
                    }
                }

                Repeater {
                    model: [
                        { key: "layout",     label: "Layout",     icon: "󰕮" },
                        { key: "appearance", label: "Appearance", icon: "󰏘" },
                        { key: "shortcuts",  label: "Shortcuts",  icon: "󰌌" }
                    ]
                    delegate: Rectangle {
                        required property var modelData
                        Layout.fillWidth: true
                        height: 38; radius: 9
                        color: settingsWindow.activeTab === modelData.key
                            ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.18)
                            : (tabMa.containsMouse ? Qt.rgba(1,1,1,0.05) : "transparent")
                        Behavior on color { ColorAnimation { duration: 150 } }
                        RowLayout {
                            anchors.fill: parent
                            anchors.leftMargin: 10
                            spacing: 8
                            Text {
                                text: modelData.icon
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 14
                                color: settingsWindow.activeTab === modelData.key ? zyuTheme.accent : zyuTheme.bar_fg
                                opacity: settingsWindow.activeTab === modelData.key ? 1 : 0.6
                            }
                            Text {
                                text: modelData.label
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                                color: settingsWindow.activeTab === modelData.key ? zyuTheme.accent : zyuTheme.bar_fg
                                opacity: settingsWindow.activeTab === modelData.key ? 1 : 0.75
                            }
                        }
                        MouseArea {
                            id: tabMa
                            anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                            onClicked: settingsWindow.activeTab = modelData.key
                        }
                    }
                }

                Item { Layout.fillHeight: true }

                Rectangle {
                    Layout.fillWidth: true
                    height: 34; radius: 9
                    color: closeMa.containsMouse ? Qt.rgba(1,0.3,0.3,0.15) : "transparent"
                    Behavior on color { ColorAnimation { duration: 150 } }
                    RowLayout {
                        anchors.centerIn: parent
                        spacing: 6
                        Text { text: "󰅖"; font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 13; color: zyuTheme.bar_fg }
                        Text { text: "Close"; font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12; color: zyuTheme.bar_fg }
                    }
                    MouseArea {
                        id: closeMa
                        anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                        onClicked: settingsState.show = false
                    }
                }
            }
        }

        Rectangle { Layout.fillHeight: true; width: 1; color: Qt.rgba(1,1,1,0.06) }

        Item {
            Layout.fillWidth: true
            Layout.fillHeight: true

            Item {
                id: layoutTab
                anchors.fill: parent
                visible: settingsWindow.activeTab === "layout"

                readonly property real sw: Math.max(1, settingsWindow.width)
                readonly property real sh: Math.max(1, settingsWindow.height)
                readonly property real pw: Math.min(width - 48, 540)
                readonly property real ph: pw * sh / sw
                readonly property real k: pw / sw
                property string selected: "clock"

                readonly property real clockW: Math.round(sw * 0.15 * root.clockScale)
                readonly property real clockH: Math.round(clockW * 0.46)
                readonly property real photoFrame: Math.round(Math.min(sw, sh) * 0.20 * root.photoScale)
                readonly property real photoW: photoFrame + 28
                readonly property real photoH: photoFrame + 34

                readonly property real clockDefX: (24 + (root.barPosition === "left" ? root.barThickness : 0)) / sw
                readonly property real clockDefY: (24 + (root.barPosition === "top" ? root.barThickness : 0)) / sh
                readonly property real photoDefX: (sw - photoW - 24 - (root.barPosition === "right" ? root.barThickness : 0)) / sw
                readonly property real photoDefY: (sh - photoH - 24 - (root.barPosition === "bottom" ? root.barThickness : 0)) / sh

                readonly property real clockPx: root.clockX >= 0 ? root.clockX : clockDefX
                readonly property real clockPy: root.clockY >= 0 ? root.clockY : clockDefY
                readonly property real photoPx: root.photoX >= 0 ? root.photoX : photoDefX
                readonly property real photoPy: root.photoY >= 0 ? root.photoY : photoDefY

                function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)) }
                readonly property real curScale: selected === "clock" ? root.clockScale : root.photoScale
                function setScale(v) {
                    v = Math.round(clamp(v, 0.5, 2.0) * 20) / 20
                    if (selected === "clock") root.clockScale = v
                    else root.photoScale = v
                }

                ColumnLayout {
                    anchors.fill: parent
                    anchors.margins: 24
                    spacing: 14

                    Text {
                        text: "Layout"
                        color: zyuTheme.bar_fg; font.family: "JetBrainsMono Nerd Font"
                        font.pixelSize: 18; font.bold: true
                    }

                    Item {
                        id: screenPreview
                        Layout.alignment: Qt.AlignHCenter
                        Layout.preferredWidth: layoutTab.pw
                        Layout.preferredHeight: layoutTab.ph

                        Rectangle {
                            anchors.fill: parent
                            radius: 8
                            color: "#111111"
                            border.width: 1
                            border.color: Qt.rgba(1, 1, 1, 0.12)
                            clip: true

                            Image {
                                anchors.fill: parent
                                source: "file://" + Quickshell.env("HOME") + "/.config/hypr/current_wallpaper"
                                fillMode: Image.PreserveAspectCrop
                                asynchronous: true
                                sourceSize: Qt.size(layoutTab.pw, layoutTab.ph)
                                opacity: 0.85
                            }

                            Rectangle {
                                color: Qt.rgba(zyuTheme.bar_bg.r, zyuTheme.bar_bg.g, zyuTheme.bar_bg.b, 0.92)
                                readonly property real t: root.barThickness * layoutTab.k
                                x: root.barPosition === "right" ? parent.width - t : 0
                                y: root.barPosition === "bottom" ? parent.height - t : 0
                                width: (root.barPosition === "left" || root.barPosition === "right") ? t : parent.width
                                height: (root.barPosition === "top" || root.barPosition === "bottom") ? t : parent.height
                            }

                            Rectangle {
                                visible: root.dockEnabled
                                width: Math.min(parent.width * 0.4, 150); height: Math.max(6, 56 * layoutTab.k)
                                radius: height / 2
                                x: (parent.width - width) / 2
                                y: parent.height - height - (10 + (root.barPosition === "bottom" ? root.barThickness : 0)) * layoutTab.k
                                color: Qt.rgba(zyuTheme.bar_bg.r, zyuTheme.bar_bg.g, zyuTheme.bar_bg.b, 0.92)
                                border.width: 1
                                border.color: Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.35)
                            }

                            Rectangle {
                                id: clockBox
                                x: layoutTab.clockPx * layoutTab.pw
                                y: layoutTab.clockPy * layoutTab.ph
                                width: layoutTab.clockW * layoutTab.k
                                height: layoutTab.clockH * layoutTab.k
                                radius: Math.max(4, zyuTheme.rounding * layoutTab.k)
                                color: zyuTheme.widget_bg
                                border.width: layoutTab.selected === "clock" ? 2 : 1
                                border.color: layoutTab.selected === "clock" ? zyuTheme.accent : Qt.rgba(1, 1, 1, 0.2)
                                Text {
                                    anchors.centerIn: parent
                                    text: "12:34"
                                    color: zyuTheme.bar_fg
                                    font.family: "JetBrainsMono Nerd Font"; font.bold: true
                                    font.pixelSize: Math.max(7, parent.height * 0.42)
                                }
                                MouseArea {
                                    id: clockDrag
                                    anchors.fill: parent
                                    cursorShape: pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
                                    property real gx: 0
                                    property real gy: 0
                                    onPressed: mouse => { layoutTab.selected = "clock"; gx = mouse.x; gy = mouse.y }
                                    onPositionChanged: mouse => {
                                        if (!pressed) return
                                        var p = mapToItem(screenPreview, mouse.x, mouse.y)
                                        root.clockX = layoutTab.clamp((p.x - gx) / layoutTab.pw, 0, Math.max(0, 1 - layoutTab.clockW / layoutTab.sw))
                                        root.clockY = layoutTab.clamp((p.y - gy) / layoutTab.ph, 0, Math.max(0, 1 - layoutTab.clockH / layoutTab.sh))
                                    }
                                    onReleased: root.saveSettings()
                                }
                            }

                            Rectangle {
                                id: photoBox
                                visible: root.photoEnabled
                                x: layoutTab.photoPx * layoutTab.pw
                                y: layoutTab.photoPy * layoutTab.ph
                                width: layoutTab.photoW * layoutTab.k
                                height: layoutTab.photoH * layoutTab.k
                                radius: root.photoShape === "circle" ? width / 2 : Math.max(4, 16 * layoutTab.k)
                                color: zyuTheme.widget_bg
                                border.width: layoutTab.selected === "photo" ? 2 : 1
                                border.color: layoutTab.selected === "photo" ? zyuTheme.accent : Qt.rgba(1, 1, 1, 0.2)
                                Text {
                                    anchors.centerIn: parent
                                    text: "󰋩"
                                    color: zyuTheme.bar_fg; opacity: 0.7
                                    font.family: "JetBrainsMono Nerd Font"
                                    font.pixelSize: Math.max(8, parent.width * 0.32)
                                }
                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: pressed ? Qt.ClosedHandCursor : Qt.OpenHandCursor
                                    property real gx: 0
                                    property real gy: 0
                                    onPressed: mouse => { layoutTab.selected = "photo"; gx = mouse.x; gy = mouse.y }
                                    onPositionChanged: mouse => {
                                        if (!pressed) return
                                        var p = mapToItem(screenPreview, mouse.x, mouse.y)
                                        root.photoX = layoutTab.clamp((p.x - gx) / layoutTab.pw, 0, Math.max(0, 1 - layoutTab.photoW / layoutTab.sw))
                                        root.photoY = layoutTab.clamp((p.y - gy) / layoutTab.ph, 0, Math.max(0, 1 - layoutTab.photoH / layoutTab.sh))
                                    }
                                    onReleased: root.saveSettings()
                                }
                            }
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 8

                        Repeater {
                            model: [
                                { key: "clock", label: "Clock" },
                                { key: "photo", label: "Photo" }
                            ]
                            delegate: Rectangle {
                                required property var modelData
                                Layout.preferredWidth: 84; Layout.preferredHeight: 32; radius: 10
                                color: layoutTab.selected === modelData.key
                                    ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.22)
                                    : Qt.rgba(1, 1, 1, 0.05)
                                border.width: layoutTab.selected === modelData.key ? 1 : 0
                                border.color: zyuTheme.accent
                                Text {
                                    anchors.centerIn: parent
                                    text: modelData.label
                                    color: layoutTab.selected === modelData.key ? zyuTheme.accent : zyuTheme.bar_fg
                                    opacity: layoutTab.selected === modelData.key ? 1 : 0.65
                                    font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                                }
                                MouseArea {
                                    anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                    onClicked: layoutTab.selected = modelData.key
                                }
                            }
                        }

                        Item { Layout.fillWidth: true }

                        Rectangle {
                            Layout.preferredWidth: 110; Layout.preferredHeight: 32; radius: 10
                            color: resetMa.containsMouse ? Qt.rgba(1, 1, 1, 0.1) : Qt.rgba(1, 1, 1, 0.05)
                            Text {
                                anchors.centerIn: parent
                                text: "Reset"
                                color: zyuTheme.bar_fg; opacity: 0.75
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                            }
                            MouseArea {
                                id: resetMa
                                anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                onClicked: {
                                    if (layoutTab.selected === "clock") { root.clockX = -1; root.clockY = -1; root.clockScale = 1.0 }
                                    else { root.photoX = -1; root.photoY = -1; root.photoScale = 1.0 }
                                    root.saveSettings()
                                }
                            }
                        }
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 12

                        Text {
                            text: "Size"
                            color: zyuTheme.bar_fg; opacity: 0.7
                            font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                        }

                        Rectangle {
                            id: sizeTrack
                            Layout.fillWidth: true
                            Layout.preferredHeight: 6
                            radius: 3
                            color: Qt.rgba(zyuTheme.bar_fg.r, zyuTheme.bar_fg.g, zyuTheme.bar_fg.b, 0.15)
                            readonly property real frac: (layoutTab.curScale - 0.5) / 1.5

                            Rectangle {
                                width: parent.width * sizeTrack.frac; height: parent.height; radius: 3
                                color: zyuTheme.accent
                            }
                            Rectangle {
                                width: 16; height: 16; radius: 8
                                anchors.verticalCenter: parent.verticalCenter
                                x: parent.width * sizeTrack.frac - width / 2
                                color: zyuTheme.accent
                            }
                            MouseArea {
                                anchors.fill: parent
                                anchors.topMargin: -10; anchors.bottomMargin: -10
                                cursorShape: Qt.PointingHandCursor
                                function apply(mx) { layoutTab.setScale(0.5 + 1.5 * Math.max(0, Math.min(1, mx / width))) }
                                onPressed: mouse => apply(mouse.x)
                                onPositionChanged: mouse => { if (pressed) apply(mouse.x) }
                                onReleased: root.saveSettings()
                            }
                        }

                        Text {
                            text: Math.round(layoutTab.curScale * 100) + "%"
                            Layout.preferredWidth: 44
                            horizontalAlignment: Text.AlignRight
                            color: zyuTheme.bar_fg; opacity: 0.7
                            font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                        }
                    }

                    Item { Layout.fillHeight: true }
                }
            }

            Flickable {
                anchors.fill: parent
                anchors.margins: 24
                visible: settingsWindow.activeTab === "appearance"
                clip: true
                contentWidth: width
                contentHeight: appearanceCol.implicitHeight
                boundsBehavior: Flickable.StopAtBounds

            ColumnLayout {
                id: appearanceCol
                width: parent.width
                spacing: 16

                Text {
                    text: "Appearance"
                    color: zyuTheme.bar_fg; font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 18; font.bold: true
                }

                Text {
                    text: "Bar position"
                    color: zyuTheme.accent; font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 12; font.bold: true
                    opacity: 0.85
                }
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10
                    Repeater {
                        model: [
                            { key: "left",   label: "Left" },
                            { key: "right",  label: "Right" },
                            { key: "top",    label: "Top" },
                            { key: "bottom", label: "Bottom" }
                        ]
                        delegate: Rectangle {
                            required property var modelData
                            Layout.fillWidth: true
                            height: 44; radius: 12
                            color: root.barPosition === modelData.key
                                ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.22)
                                : Qt.rgba(1,1,1,0.05)
                            border.width: root.barPosition === modelData.key ? 1 : 0
                            border.color: zyuTheme.accent
                            Behavior on color { ColorAnimation { duration: 150 } }
                            Text {
                                anchors.centerIn: parent
                                text: modelData.label
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 13
                                color: root.barPosition === modelData.key ? zyuTheme.accent : zyuTheme.bar_fg
                                opacity: root.barPosition === modelData.key ? 1 : 0.65
                            }
                            MouseArea {
                                anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                onClicked: { root.barPosition = modelData.key; root.saveSettings() }
                            }
                        }
                    }
                }

                Rectangle { Layout.fillWidth: true; height: 1; color: Qt.rgba(1,1,1,0.06); Layout.topMargin: 4; Layout.bottomMargin: 4 }

                Text {
                    text: "Music Player"
                    color: zyuTheme.accent; font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 12; font.bold: true
                    opacity: 0.85
                }
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10
                    Repeater {
                        model: [
                            { key: "MusicPanel", label: "󰠺  Classic (card)" },
                            { key: "Cyna",       label: "󰐊  Cyna (pill)" }
                        ]
                        delegate: Rectangle {
                            required property var modelData
                            Layout.fillWidth: true
                            height: 52; radius: 12
                            color: root.selectedMusic === modelData.key
                                ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.22)
                                : Qt.rgba(1,1,1,0.05)
                            border.width: root.selectedMusic === modelData.key ? 1 : 0
                            border.color: zyuTheme.accent
                            Behavior on color { ColorAnimation { duration: 150 } }
                            Text {
                                anchors.centerIn: parent
                                text: modelData.label
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 13
                                color: root.selectedMusic === modelData.key ? zyuTheme.accent : zyuTheme.bar_fg
                                opacity: root.selectedMusic === modelData.key ? 1 : 0.65
                            }
                            MouseArea {
                                anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                onClicked: { root.selectedMusic = modelData.key; root.saveSettings() }
                            }
                        }
                    }
                }

                Rectangle { Layout.fillWidth: true; height: 1; color: Qt.rgba(1,1,1,0.06); Layout.topMargin: 4; Layout.bottomMargin: 4 }

                RowLayout {
                    Layout.fillWidth: true
                    Text {
                        text: "Dock"
                        color: zyuTheme.accent; font.family: "JetBrainsMono Nerd Font"
                        font.pixelSize: 12; font.bold: true
                        opacity: 0.85
                    }
                    Item { Layout.fillWidth: true }

                    Rectangle {
                        Layout.preferredWidth: 42; Layout.preferredHeight: 22; radius: 11
                        color: root.dockEnabled
                            ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.35)
                            : Qt.rgba(1, 1, 1, 0.08)
                        border.width: 1
                        border.color: root.dockEnabled ? zyuTheme.accent : Qt.rgba(1, 1, 1, 0.15)
                        Behavior on color { ColorAnimation { duration: 150 } }

                        Rectangle {
                            width: 16; height: 16; radius: 8
                            anchors.verticalCenter: parent.verticalCenter
                            x: root.dockEnabled ? parent.width - width - 3 : 3
                            color: root.dockEnabled ? zyuTheme.accent : zyuTheme.bar_fg
                            opacity: root.dockEnabled ? 1 : 0.5
                            Behavior on x { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
                        }
                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: { root.dockEnabled = !root.dockEnabled; root.saveSettings() }
                        }
                    }
                }

                Flow {
                    id: favFlow
                    Layout.fillWidth: true
                    spacing: 8
                    opacity: root.dockEnabled ? 1.0 : 0.35

                    Repeater {
                        model: settingsWindow.effectiveFavs
                        delegate: Rectangle {
                            id: favChip
                            required property string modelData
                            height: 28; radius: 14
                            width: chipRow.implicitWidth + 20
                            color: Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.16)
                            Row {
                                id: chipRow
                                anchors.centerIn: parent
                                spacing: 8
                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: favChip.modelData
                                    color: zyuTheme.bar_fg
                                    font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 11
                                }
                                Text {
                                    anchors.verticalCenter: parent.verticalCenter
                                    text: "×"
                                    color: zyuTheme.bar_fg; opacity: chipMa.containsMouse ? 1 : 0.5
                                    font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 14
                                    MouseArea {
                                        id: chipMa
                                        anchors.fill: parent; anchors.margins: -6
                                        hoverEnabled: true; cursorShape: Qt.PointingHandCursor
                                        onClicked: settingsWindow.removeFav(favChip.modelData)
                                    }
                                }
                            }
                        }
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10
                    opacity: root.dockEnabled ? 1.0 : 0.35

                    Rectangle {
                        Layout.fillWidth: true
                        height: 36; radius: 10
                        color: Qt.rgba(1, 1, 1, 0.05)
                        border.width: 1
                        border.color: Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, favInput.activeFocus ? 0.5 : 0.2)

                        TextInput {
                            id: favInput
                            anchors.fill: parent
                            anchors.leftMargin: 12; anchors.rightMargin: 12
                            verticalAlignment: TextInput.AlignVCenter
                            color: zyuTheme.bar_fg
                            font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                            clip: true
                            onAccepted: { settingsWindow.addFav(text); text = "" }

                            Text {
                                anchors.verticalCenter: parent.verticalCenter
                                text: "Add app (e.g. firefox)"
                                visible: !favInput.text.length
                                color: zyuTheme.bar_fg; opacity: 0.35
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                            }
                        }
                    }

                    Rectangle {
                        Layout.preferredWidth: 64; Layout.preferredHeight: 36; radius: 10
                        color: Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.2)
                        border.width: 1; border.color: zyuTheme.accent
                        Text {
                            anchors.centerIn: parent
                            text: "Add"
                            color: zyuTheme.accent
                            font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12; font.bold: true
                        }
                        MouseArea {
                            anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                            onClicked: { settingsWindow.addFav(favInput.text); favInput.text = "" }
                        }
                    }
                }

                Rectangle { Layout.fillWidth: true; height: 1; color: Qt.rgba(1,1,1,0.06); Layout.topMargin: 4; Layout.bottomMargin: 4 }

                RowLayout {
                    Layout.fillWidth: true
                    Text {
                        text: "Photo Widget"
                        color: zyuTheme.accent; font.family: "JetBrainsMono Nerd Font"
                        font.pixelSize: 12; font.bold: true
                        opacity: 0.85
                    }
                    Item { Layout.fillWidth: true }

                    Rectangle {
                        Layout.preferredWidth: 42; Layout.preferredHeight: 22; radius: 11
                        color: root.photoEnabled
                            ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.35)
                            : Qt.rgba(1, 1, 1, 0.08)
                        border.width: 1
                        border.color: root.photoEnabled ? zyuTheme.accent : Qt.rgba(1, 1, 1, 0.15)
                        Behavior on color { ColorAnimation { duration: 150 } }

                        Rectangle {
                            width: 16; height: 16; radius: 8
                            anchors.verticalCenter: parent.verticalCenter
                            x: root.photoEnabled ? parent.width - width - 3 : 3
                            color: root.photoEnabled ? zyuTheme.accent : zyuTheme.bar_fg
                            opacity: root.photoEnabled ? 1 : 0.5
                            Behavior on x { NumberAnimation { duration: 180; easing.type: Easing.OutCubic } }
                        }

                        MouseArea {
                            anchors.fill: parent
                            cursorShape: Qt.PointingHandCursor
                            onClicked: { root.photoEnabled = !root.photoEnabled; root.saveSettings() }
                        }
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10
                    opacity: root.photoEnabled ? 1.0 : 0.35
                    enabled: root.photoEnabled
                    Behavior on opacity { NumberAnimation { duration: 150 } }
                    Repeater {
                        model: [
                            { key: "square", label: "󰝤  Square" },
                            { key: "circle", label: "󰺕  Circle" }
                        ]
                        delegate: Rectangle {
                            required property var modelData
                            Layout.fillWidth: true
                            height: 44; radius: 12
                            color: root.photoShape === modelData.key
                                ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.22)
                                : Qt.rgba(1,1,1,0.05)
                            border.width: root.photoShape === modelData.key ? 1 : 0
                            border.color: zyuTheme.accent
                            Behavior on color { ColorAnimation { duration: 150 } }
                            Text {
                                anchors.centerIn: parent
                                text: modelData.label
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                                color: root.photoShape === modelData.key ? zyuTheme.accent : zyuTheme.bar_fg
                                opacity: root.photoShape === modelData.key ? 1 : 0.65
                            }
                            MouseArea {
                                anchors.fill: parent; cursorShape: Qt.PointingHandCursor
                                onClicked: { root.photoShape = modelData.key; root.saveSettings() }
                            }
                        }
                    }
                }

                RowLayout {
                    Layout.fillWidth: true
                    spacing: 10

                    Rectangle {
                        Layout.fillWidth: true
                        height: 40; radius: 10
                        color: Qt.rgba(1,1,1,0.05)
                        border.width: 1
                        border.color: Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.25)

                        RowLayout {
                            anchors.fill: parent
                            anchors.leftMargin: 12; anchors.rightMargin: 10
                            spacing: 8

                            Text {
                                text: "󰉏"
                                color: zyuTheme.bar_fg; opacity: 0.6
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 13
                            }

                            TextInput {
                                id: photoPathInput
                                Layout.fillWidth: true
                                Layout.fillHeight: true
                                text: root.photoPath
                                color: zyuTheme.bar_fg
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                                verticalAlignment: TextInput.AlignVCenter
                                clip: true
                                onAccepted: { root.photoPath = text; root.saveSettings() }
                                Text {
                                    text: "/home/user/Pictures/photo.jpg"
                                    color: zyuTheme.bar_fg; opacity: 0.35
                                    visible: !photoPathInput.text
                                    anchors.left: parent.left
                                    anchors.verticalCenter: parent.verticalCenter
                                    font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12
                                }
                            }
                        }
                    }

                    Rectangle {
                        Layout.preferredWidth: 84
                        height: 40; radius: 10
                        color: savePhotoMa.containsMouse
                            ? Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.30)
                            : Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.20)
                        border.width: 1
                        border.color: zyuTheme.accent
                        Behavior on color { ColorAnimation { duration: 150 } }

                        Text {
                            anchors.centerIn: parent
                            text: "Kaydet"
                            color: zyuTheme.accent
                            font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 12; font.bold: true
                        }
                        MouseArea {
                            id: savePhotoMa
                            anchors.fill: parent
                            hoverEnabled: true
                            cursorShape: Qt.PointingHandCursor
                            onClicked: { root.photoPath = photoPathInput.text; root.saveSettings() }
                        }
                    }
                }

                Item { Layout.fillHeight: true }
            }
            }

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 24
                spacing: 12
                visible: settingsWindow.activeTab === "shortcuts"

                Text {
                    text: "Shortcuts"
                    color: zyuTheme.bar_fg; font.family: "JetBrainsMono Nerd Font"
                    font.pixelSize: 18; font.bold: true
                }
                Text {
                    text: "hyprland.lua'daki kısayolların referans listesi (salt okunur)."
                    font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 11
                    color: zyuTheme.bar_fg; opacity: 0.5
                }

                ListView {
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    clip: true
                    spacing: 2
                    model: settingsWindow.shortcuts
                    delegate: Rectangle {
                        required property var modelData
                        width: ListView.view.width
                        height: 38; radius: 8
                        color: shortcutMa.containsMouse ? Qt.rgba(1,1,1,0.04) : "transparent"
                        RowLayout {
                            anchors.fill: parent
                            anchors.leftMargin: 10; anchors.rightMargin: 10
                            Rectangle {
                                Layout.preferredWidth: keyText.implicitWidth + 16
                                height: 24; radius: 6
                                color: Qt.rgba(zyuTheme.accent.r, zyuTheme.accent.g, zyuTheme.accent.b, 0.15)
                                Text {
                                    id: keyText
                                    anchors.centerIn: parent
                                    text: modelData.keys
                                    font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 10; font.bold: true
                                    color: zyuTheme.accent
                                }
                            }
                            Text {
                                Layout.fillWidth: true
                                Layout.leftMargin: 12
                                text: modelData.action
                                font.family: "JetBrainsMono Nerd Font"; font.pixelSize: 11
                                color: zyuTheme.bar_fg; opacity: 0.8
                            }
                        }
                        MouseArea { id: shortcutMa; anchors.fill: parent; hoverEnabled: true }
                    }
                }
            }
        }
    }
    }
}
