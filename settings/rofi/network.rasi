@import "colors.rasi"
@import "font.rasi"

configuration {
    modi:                   "drun,run";
    show-icons:             false;
    display-drun:           ">";
    display-run:            ">";
    display-filebrowser:    "FILES";
    display-window:         "WINDOW";
    drun-display-format:    "{name}";
    hover-select:           false;
    scroll-method:          1;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
    window-format:          "{w} · {c} · {t}";
}

* {
    background-color: transparent;
    text-color:       @text;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

window {
    width:                  350px;
    x-offset:               0px;
    y-offset:               0px;
    spacing:                0px;
    padding:                10px;
    margin:                 0px; 
    border:                 1px solid;
    border-color:           @bg2;
    cursor:                 "default";
    transparency:           "real";
    location:               center;
    anchor:                 center;
    fullscreen:             false;
    enabled:                true;
    border-radius:          12px;
    background-color:       @bg0;
}

mainbox {
    spacing:                4px;
    margin:                 0;
    padding:                0;
    background-color:       @bg0;
    text-color:             @text;
    children:               ["inputbar", "listview", "message"];
}

inputbar {
    children:               ["prompt", "entry"];
    spacing:                2px;
    border-radius:          8px;
    padding:                6px;
    background-color:       @bg1;
    text-color:             @text;
    border:                 1px solid;
    border-color:           @bg3;
}

prompt {
    enabled:                true;
    padding:                0 5px 0 5px;
    background-color:       transparent;
    text-color:             @blue;
}

entry {
    placeholder:            "find the trizen";
    padding:                2px;
    background-color:       transparent;
    text-color:             @text;
    placeholder-color:      @grey1;
}

listview {
    columns:                1;
    lines:                  5;
    fixed-height:           true;
    fixed-columns:          true;
    cycle:                  false;
    scrollbar:              false;
    border:                 0px solid;
    border-radius:          8px;
    background-color:       transparent;
    text-color:             @text;
    spacing:                4px;
    padding:                4px 0px;
}

element {
    spacing:                0;
    margin:                 0;
    padding:                8px;
    border:                 0px solid;
    border-radius:          6px;
    background-color:       transparent;
    text-color:             @text;
    cursor:                 pointer;
}

element normal.normal {
    background-color:       transparent;
    text-color:             @text;
}

element alternate.normal {
    background-color:       transparent;
    text-color:             @text;
}

element selected.normal {
    background-color:       @bg1;
    text-color:             @blue;
}

element selected.active {
    background-color:       @bg1;
    text-color:             @blue;
}
